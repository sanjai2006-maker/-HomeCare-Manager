{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "MaintenanceTask": {
      "title": "Maintenance Task",
      "description": "A scheduled maintenance task",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["structural", "electrical", "plumbing", "cleaning", "safety", "other"] },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly", "one-time"] },
        "lastDone": { "type": "string", "format": "date-time" },
        "nextDue": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "completed", "urgent"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "title", "frequency", "nextDue", "status"]
    },
    "MaintenanceHistory": {
      "title": "Maintenance History",
      "description": "Log of completed maintenance activities",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner UID" },
        "taskId": { "type": "string", "description": "Reference to the original task" },
        "taskTitle": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "cost": { "type": "number" }
      },
      "required": ["uid", "taskId", "taskTitle", "completedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/tasks/{taskId}": {
      "schema": "MaintenanceTask",
      "description": "Maintenance tasks for all users"
    },
    "/history/{historyId}": {
      "schema": "MaintenanceHistory",
      "description": "Completed task logs"
    }
  }
}
